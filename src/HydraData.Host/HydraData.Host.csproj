<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HydraData.Engine\HydraData.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship appsettings.json next to the executable so the host finds it without extra config. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- net10.0/Nullable/ImplicitUsings inherited from root Directory.Build.props. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- This is the console entry point (an exe), not a packable library: its types are host-process
         internals, so doc-gen would only emit CS1591 noise (TreatWarningsAsErrors would then fail the
         build). Turn it off here, mirroring test/Directory.Build.props; the public Engine surface keeps
         its XML docs. (T09.8 note.) -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
